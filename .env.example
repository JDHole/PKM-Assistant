# PKM Assistant - Environment Variables
# Copy this file to .env and fill in your values

# Comma-separated paths to Obsidian vaults where plugin should be auto-deployed after build
# Example: C:/Users/YourName/Documents/MyVault,C:/Users/YourName/Documents/TestVault
DESTINATION_VAULTS=

# Release only (npm run release) - GitHub token with repo scope + target repo
# Token is read from env, never stored in files; see RELEASE_PROCESS.md
GH_TOKEN=
GH_REPO=JDHole/pkm-assistant
